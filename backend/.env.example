# Variables de entorno del backend
# Copiar este archivo como .env y completar los valores reales
# NUNCA subir el archivo .env al repositorio

# Puerto del servidor Express
PORT=3001

# Entorno de ejecución: development | production
NODE_ENV=development

# URL del frontend (requerida en producción para la política CORS)
# Ejemplo: https://tu-proyecto.vercel.app
FRONTEND_URL=

# --- Google Cloud Document AI ---
GOOGLE_APPLICATION_CREDENTIALS=./credenciales/gcp-service-account.json
DOCUMENT_AI_PROJECT_ID=tu-proyecto-gcp
DOCUMENT_AI_LOCATION=us
DOCUMENT_AI_PROCESSOR_ID=tu-processor-id

# --- Google Gemini API ---
GEMINI_API_KEY=tu-api-key-de-gemini

# --- Supabase ---
# Usar la service_role key (NO la anon key) — nunca exponer en el frontend
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGc...

# --- Panel de Administración ---
# Token secreto que la profe usa para acceder al dashboard
# Debe ser una cadena larga y aleatoria — ejemplo: openssl rand -base64 32
ADMIN_TOKEN=tu-token-secreto-admin
